datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id         Int            @id @default(autoincrement())
  categories PostCategory[] 
}

model Category {
  id    Int            @id @default(autoincrement())
  posts PostCategory[] 
}

model PostCategory {
  postId     Int
  categoryId Int
  post       Post     @relation(fields: [postId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([postId, categoryId])
}
